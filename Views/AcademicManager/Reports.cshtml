@model List<PART_3.Models.Claim>

@{
    ViewData["Title"] = "Reports - Academic Manager";
    var totalClaims = Model.Count;
    var approvedClaims = Model.Count(c => c.Status == PART_3.Models.ClaimStatus.Approved);
    var pendingClaims = Model.Count(c => c.Status == PART_3.Models.ClaimStatus.Submitted);
    var rejectedClaims = Model.Count(c => c.Status == PART_3.Models.ClaimStatus.Rejected);
    var paidClaims = Model.Count(c => c.Status == PART_3.Models.ClaimStatus.Paid);
    var totalPayments = Model.Where(c => c.Status == PART_3.Models.ClaimStatus.Approved).Sum(c => c.TotalAmount);
    var totalPaid = Model.Where(c => c.Status == PART_3.Models.ClaimStatus.Paid).Sum(c => c.TotalAmount);
}

<h2>Academic Reports Dashboard</h2>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Total Claims</h5>
                        <h2 class="card-text">@totalClaims</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-file-invoice fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Approved</h5>
                        <h2 class="card-text">@approvedClaims</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-check-circle fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Pending</h5>
                        <h2 class="card-text">@pendingClaims</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-clock fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title">Paid</h5>
                        <h2 class="card-text">@paidClaims</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-money-bill-wave fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Financial Summary -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card bg-light">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Financial Summary</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-6">
                        <h3 class="text-success">R @totalPayments.ToString("F2")</h3>
                        <p class="text-muted">Pending Payments</p>
                    </div>
                    <div class="col-md-6">
                        <h3 class="text-info">R @totalPaid.ToString("F2")</h3>
                        <p class="text-muted">Total Paid</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-light">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-percentage me-2"></i>Approval Rate</h5>
            </div>
            <div class="card-body text-center">
                @{
                    var approvalRate = totalClaims > 0 ? (approvedClaims * 100.0 / totalClaims) : 0;
                }
                <h1 class="display-4 text-primary">@approvalRate.ToString("F1")%</h1>
                <p class="text-muted">Claims Approved</p>
            </div>
        </div>
    </div>
</div>

<!-- Claims by Status Chart -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Claims Distribution</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <canvas id="claimsChart" width="400" height="200"></canvas>
                    </div>
                    <div class="col-md-4">
                        <div class="mt-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-primary">Submitted</span>
                                <span>@pendingClaims</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-success">Approved</span>
                                <span>@approvedClaims</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-danger">Rejected</span>
                                <span>@rejectedClaims</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-info">Paid</span>
                                <span>@paidClaims</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Detailed Claims Table -->
<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-list me-2"></i>All Claims Summary</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Lecturer</th>
                        <th>Module</th>
                        <th>Hours</th>
                        <th>Rate</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Submitted</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in Model.OrderByDescending(c => c.SubmittedDate))
                    {
                        <tr>
                            <td>@claim.Id</td>
                            <td>
                                @if (claim.Lecturer != null)
                                {
                                    @claim.Lecturer.FirstName @claim.Lecturer.LastName
                                }
                                else
                                {
                                    <span class="text-muted">Unknown</span>
                                }
                        </td>
                        <td>@claim.ModuleName</td>
                        <td>@claim.HoursWorked</td>
                        <td>R @claim.HourlyRate</td>
                        <td><strong>R @claim.TotalAmount</strong></td>
                        <td>
                            <span class="badge
                                    @(claim.Status == PART_3.Models.ClaimStatus.Approved ? "bg-success" :
                                                                        claim.Status == PART_3.Models.ClaimStatus.Rejected ? "bg-danger" :
                                                                        claim.Status == PART_3.Models.ClaimStatus.Paid ? "bg-info" : "bg-warning")">
                                @claim.Status
                            </span>
                        </td>
                        <td>@claim.SubmittedDate.ToString("MMM dd, yyyy")</td>
                    </tr>
                                        }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="mt-4">
    <a href="@Url.Action("AllClaims", "AcademicManager")" class="btn btn-info">
        <i class="fas fa-eye me-2"></i>View All Claims
    </a>
    <a href="@Url.Action("Dashboard", "Home")" class="btn btn-secondary">
        <i class="fas fa-tachometer-alt me-2"></i>Back to Dashboard
    </a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Pie chart for claims distribution
            var ctx = document.getElementById('claimsChart').getContext('2d');
            var claimsChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: ['Submitted', 'Approved', 'Rejected', 'Paid'],
                    datasets: [{
                        data: [@pendingClaims, @approvedClaims, @rejectedClaims, @paidClaims],
                        backgroundColor: [
                            '#ffc107', // Warning (yellow)
                            '#198754', // Success (green)
                            '#dc3545', // Danger (red)
                            '#0dcaf0'  // Info (blue)
                        ],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    var label = context.label || '';
                                    var value = context.raw || 0;
                                    var total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    var percentage = Math.round((value / total) * 100);
                                    return label + ': ' + value + ' (' + percentage + '%)';
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}