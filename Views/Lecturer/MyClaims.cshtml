@model List<PART_3.Models.Claim>

@{
    ViewData["Title"] = "My Claims";
}

<h2>My Claims</h2>

<!-- Success Popup Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="successModalLabel">
                    <i class="fas fa-check-circle me-2"></i>Success!
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="fas fa-check-circle text-success fa-3x"></i>
                </div>
                <h4>Claim Submitted Successfully!</h4>
                <p class="mb-0">Your claim has been submitted and is awaiting approval.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">Continue</button>
            </div>
        </div>
    </div>
</div>

<!-- Regular Success Message -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Module</th>
                    <th>Hours</th>
                    <th>Rate</th>
                    <th>Total</th>
                    <th>Claim Date</th>
                    <th>Status</th>
                    <th>Submitted</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model.OrderByDescending(c => c.SubmittedDate))
                {
                    <tr>
                        <td>@claim.Id</td>
                        <td>@claim.ModuleName</td>
                        <td>@claim.HoursWorked</td>
                        <td>R @claim.HourlyRate</td>
                        <td><strong>R @claim.TotalAmount</strong></td>
                        <td>@claim.ClaimDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <span class="badge
                                        @(claim.Status == PART_3.Models.ClaimStatus.Approved ? "bg-success" :
                                                                    claim.Status == PART_3.Models.ClaimStatus.Rejected ? "bg-danger" :
                                                                    claim.Status == PART_3.Models.ClaimStatus.Paid ? "bg-info" : "bg-warning")">
                        @claim.Status
                    </span>
                </td>
                <td>@claim.SubmittedDate.ToString("MMM dd, yyyy")</td>
            </tr>
                        }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>
        You haven't submitted any claims yet. <a href="@Url.Action("SubmitClaim")" class="alert-link">Submit your first claim</a> to get started.
    </div>
}

<div class="mt-3">
    <a href="@Url.Action("SubmitClaim")" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Submit New Claim
    </a>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Show success popup if redirected from successful submission
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>
                    $('#successModal').modal('show');
                    </text>
            }

            // Auto-hide the popup after 3 seconds
            $('#successModal').on('shown.bs.modal', function () {
                setTimeout(function() {
                    $('#successModal').modal('hide');
                }, 3000);
            });
        });
    </script>
}