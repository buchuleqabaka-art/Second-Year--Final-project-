@model dynamic

@{
    ViewData["Title"] = "Login";
}

<div class="login-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="login-card">
                    <div class="login-header text-center">
                        <h3 class="mb-2"><i class="fas fa-sign-in-alt me-2"></i>Login</h3>
                        <p class="mb-0">Access your Contract Claim System</p>
                    </div>
                    <div class="card-body p-4">
                        <form method="post">
                            <div class="mb-3">
                                <label for="username" class="form-label">Username</label>
                                <input type="text" class="form-control" id="username" name="username" required
                                       placeholder="Enter your username">
                            </div>
                            <div class="mb-4">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" class="form-control" id="password" name="password" required
                                       placeholder="Enter your password">
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2">
                                <i class="fas fa-sign-in-alt me-2"></i>Login
                            </button>
                        </form>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger mt-3">
                                <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.Error
                            </div>
                        }

                        <!-- Demo Accounts -->
                        <div class="mt-4 pt-3 border-top">
                            <h6 class="text-center mb-3 text-muted">Accounts</h6>
                            <div class="row small text-center">
                                <div class="col-6 mb-2">
                                    <strong class="text-primary">Lecturer</strong><br>
                                    lecturer1 / password
                                </div>
                                <div class="col-6 mb-2">
                                    <strong class="text-primary">Coordinator</strong><br>
                                    coordinator / password
                                </div>
                                <div class="col-6 mb-2">
                                    <strong class="text-primary">Manager</strong><br>
                                    manager / password
                                </div>
                                <div class="col-6 mb-2">
                                    <strong class="text-primary">HR</strong><br>
                                    hr / password
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>